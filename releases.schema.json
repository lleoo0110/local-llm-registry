{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "releases",
  "type": "object",
  "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
  "additionalProperties": {
    "type": "object",
    "required": ["version"],
    "additionalProperties": false,
    "properties": {
      "version": {"type": "string", "pattern": "^v?[0-9]{1,6}(\\.[0-9]{1,6}){0,3}$"}
    }
  }
}
